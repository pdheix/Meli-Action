    {
      "channel_name": "ZED TV - ضد تی وی",
      "channel_username": "zedTV",
      "message_id": 12085,
      "message_link": "https://t.me/zedTV/12085",
      "text": "تأیید رسمی کاهش سهمیه بنزین توسط رئیس دفتر ریاست‌جمهوری.\nعرضه بنزین مازاد با قیمت بالاتر؛ نرخ نهایی همچنان در ابهام.\nتشدید فشارهای معیشتی بر شهروندان در پی سوءمدیریت اقتصادی رژیم.",
      "shamsi_date": "1405/06/02",
      "tehran_time": "13:33:57",
      "gregorian_utc": "2026-08-24T10:03:57+00:00",
      "media_type": null,
      "media_size_bytes": 0,
      "media_size_human": null,
      "media_downloaded": false,
      "media_local_path": null,
